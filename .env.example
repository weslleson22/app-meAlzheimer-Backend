# Exemplo de Variáveis de Ambiente
# Copie este arquivo para .env e preencha com seus valores

# Ambiente
NODE_ENV=development

# Porta do Servidor
PORT=3333

# Banco de Dados
DATABASE_URL=./src/database/database.sqlite

# URLs de Imagem (para testes locais)
IMAGE_BASE_URL=http://localhost:3333

# URLs de Imagem (para testes em rede local)
# IMAGE_BASE_URL=http://192.168.0.6:3333

# Configurações CORS (opcional)
CORS_ORIGIN=*

# Limites de Upload
MAX_FILE_SIZE=5242880
# 5MB em bytes (5 * 1024 * 1024)

# Tipos de Arquivo Permitidos
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif

# Diretório de Uploads
UPLOAD_DIR=./uploads
